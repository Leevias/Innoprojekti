<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="MQTTsubscriber" Id="{17a63115-7cef-4886-81b6-f20acea8d209}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK MQTTsubscriber
VAR_INPUT
    bEnable     : BOOL := TRUE;
    sHostName   : STRING(255) := '192.168.0.100';   // The PC's IP on the PLC network
    nHostPort   : UINT := 1883;
    sClientId   : STRING(255) := 'CX7000-subscriber';      // Must differ from the publisher's
    sTopicSub   : STRING(255) := 'plc/pid/#';
END_VAR
VAR_OUTPUT
    bConnected  : BOOL;
    bSubscribed : BOOL;
    bError      : BOOL;
    hrErrorCode : HRESULT;
    nRxCount    : UDINT;                             // Number of messages received (for debugging)
END_VAR
VAR_IN_OUT
    fSetpoint   : REAL;                              // Only changed when a message arrives
    fKp         : REAL;
    fKi         : REAL;
END_VAR
VAR
    fbMqttClient   : FB_IotMqttClient;
    fbMessageQueue : FB_IotMqttMessageQueue;
    fbMessage      : FB_IotMqttMessage;
    bInit          : BOOL := TRUE;
    sTopicRcv      : STRING(255);
    sPayloadRcv    : STRING(255);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Set the connection parameters once
IF bInit THEN
    bInit := FALSE;
    fbMqttClient.sHostName      := sHostName;
    fbMqttClient.nHostPort      := nHostPort;
    fbMqttClient.sClientId      := sClientId;
    fbMqttClient.ipMessageQueue := fbMessageQueue;
END_IF

// Must be called every cycle
fbMqttClient.Execute(bEnable);

bConnected  := fbMqttClient.bConnected;
bError      := fbMqttClient.bError;
hrErrorCode := fbMqttClient.hrErrorCode;

IF bConnected THEN
    // Subscribe once after connecting
    IF NOT bSubscribed THEN
        bSubscribed := fbMqttClient.Subscribe(sTopic := sTopicSub,
                                              eQoS   := TcIotMqttQos.AtMostOnceDelivery);
    END_IF

    // Handle all received messages
    WHILE fbMessageQueue.nQueuedMessages > 0 DO
        IF fbMessageQueue.Dequeue(fbMessage := fbMessage) THEN
            fbMessage.GetTopic(pTopic := ADR(sTopicRcv), nTopicSize := SIZEOF(sTopicRcv));
            fbMessage.GetPayload(pPayload            := ADR(sPayloadRcv),
                                 nPayloadSize        := SIZEOF(sPayloadRcv),
                                 bSetNullTermination := TRUE);
            nRxCount := nRxCount + 1;

            IF sTopicRcv = 'plc/pid/setpoint' THEN
                fSetpoint := STRING_TO_REAL(sPayloadRcv);
            ELSIF sTopicRcv = 'plc/pid/kp' THEN
                fKp := STRING_TO_REAL(sPayloadRcv);
            ELSIF sTopicRcv = 'plc/pid/ki' THEN
                fKi := STRING_TO_REAL(sPayloadRcv);
            END_IF
            // plc/pid/temp (the PLC's own publication) is ignored
        END_IF
    END_WHILE
ELSE
    bSubscribed := FALSE;   // Subscribe again after reconnecting
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>